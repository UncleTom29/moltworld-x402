# Moltworld Configuration Environment Variables

# Network Selection: "testnet" or "mainnet" (defaults to testnet)
ALGORAND_NETWORK=testnet

# Algorand PayTo Address (Merchant Address receiving USDC)
# Required for mainnet. A default funded/valid testnet address is provided if omitted.
AVM_ADDRESS=XFYEO7VOP3KX2YHZLQBQLM6L565IQJWYZGNG36OF44GYW5FF2FQXURFR7Q

# GoPlausible x402 Facilitator Endpoint
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Public Root Domain
PUBLIC_DOMAIN=https://moltworld.xyz

# Server Listening Port
PORT=3000

# Upstream AI Provider Keys (Only provide keys for providers actually enabled)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=

# Mock Provider Mode: Set to "true" to simulate AI responses without external API keys
MOCK_PROVIDERS=false

# Optional Model Price Overrides (defaults: gpt=$0.03, claude=$0.03, gemini=$0.02, deepseek=$0.01)
# PRICE_GPT=$0.03
# PRICE_CLAUDE=$0.03
# PRICE_GEMINI=$0.02
# PRICE_DEEPSEEK=$0.01

# Test Client Signer (Base64-encoded 64-byte Ed25519 secret key, optional for running test client)
# AVM_CLIENT_PRIVATE_KEY=
