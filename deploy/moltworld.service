[Unit]
Description=Moltworld x402 AI Model Gateway
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/moltworld
EnvironmentFile=/opt/moltworld/.env
ExecStart=/usr/bin/node /opt/moltworld/dist/server.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
